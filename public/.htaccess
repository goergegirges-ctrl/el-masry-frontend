<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force www → non-www (https)
  RewriteCond %{HTTP_HOST} ^www\.elmasry-electronics\.com [NC]
  RewriteRule ^ https://elmasry-electronics.com%{REQUEST_URI} [R=301,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
